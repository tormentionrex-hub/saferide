# Copia este archivo como .env y completa los valores. No subas el .env.

# --- Panel (Vite: solo las variables VITE_ llegan al navegador) ---
# URL base de la API de SafeRide.
VITE_API_URL=http://localhost:8080/api/v1
# URL del agente local de quejas (scripts/sync_complaints.cjs).
VITE_COMPLAINTS_AGENT_URL=http://localhost:3001
# Documentos simulados para demos sin backend de documentos. Solo "true" lo activa;
# con el modo activo el panel muestra un aviso y no permite aprobar ni rechazar.
VITE_DOCUMENTS_MOCK=false

# --- Agente de quejas (scripts/sync_complaints.cjs, corre en Node, no en el navegador) ---
SUPPORT_EMAIL=soporte@example.com
SUPPORT_EMAIL_PASSWORD=contraseña-de-aplicación-de-ejemplo
GEMINI_API_KEY=clave-de-ejemplo
# Puerto local del agente (escucha solo en 127.0.0.1).
COMPLAINTS_AGENT_PORT=3001
# Orígenes del panel que pueden llamar al agente, separados por coma.
COMPLAINTS_PANEL_ORIGIN=http://localhost:5173
