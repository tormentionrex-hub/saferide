{
  "name": "saferide-backend",
  "version": "1.0.0",
  "description": "Backend API for Safe-Ride carpooling application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "db:init": "node src/scripts/initDatabase.js",
    "job:metrics": "node -e 'require(\"./src/jobs\").calculateMetricsJob().then(() => process.exit(0))'",
    "job:cleanup": "node -e 'require(\"./src/jobs\").cleanupExpiredRidesJob().then(() => process.exit(0))'",
    "job:reminders": "node -e 'require(\"./src/jobs\").sendRideRemindersJob().then(() => process.exit(0))'",
    "docs:generate": "node src/scripts/generate-postman.js",
    "docs:postman": "npm run docs:generate && openapi2postmanv2 -s swagger-spec.json -o postman-collection.json -p"
  },
  "keywords": [
    "carpooling",
    "azure",
    "nodejs",
    "api"
  ],
  "author": "Jose Pablo Muñoz Carvajal",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@azure/cosmos": "^4.7.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/storage-blob": "^12.29.1",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongodb": "^3.7.4",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "passport-http-bearer": "^1.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
