# Servidor
NODE_ENV=development
PORT=8080
API_VERSION=v1

# Cosmos DB for MongoDB (vCore) o MongoDB local
# Si tu conexión en MongoDB Compass se llama "SafeRide", copia aquí su URI,
# no el nombre: mongodb://127.0.0.1:27017 o mongodb+srv://usuario:password@host
COSMOS_CONNECTION_STRING=mongodb://127.0.0.1:27017
COSMOS_DATABASE=NaoSafeRide

# JWT Authentication
JWT_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
JWT_EXPIRE=1h
REFRESH_TOKEN_EXPIRE=7d

# Cuenta administradora creada por `npm run db:seed:admin`
ADMIN_NAME=Administrador SafeRide
ADMIN_USERNAME=admin_saferide
ADMIN_EMAIL=admin@saferide.cr
ADMIN_PASSWORD=change-me-admin-password

# Password usada por los usuarios demo del seed
DEMO_USER_PASSWORD=change-me-demo-password

# Correo (SMTP de Gmail usado por el backend)
EMAIL_USER=
EMAIL_PASS=

# Azure Blob Storage (el backend NO usa Cloudinary)
BLOB_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
BLOB_ACCOUNT_NAME=
BLOB_ACCOUNT_KEY=

# Azure Key Vault (opcional)
KEY_VAULT_URL=

# Azure AD / Entra ID (opcional)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# Zona horaria de la app
APP_TIMEZONE=America/Costa_Rica

# PayPal (sandbox: https://api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CRC_PER_USD=510

# Clave de Google Maps del servidor: Directions, Places y Geocoding, restringida por IP
GOOGLE_MAPS_SERVER_KEY=

# Swagger (/api-docs) solo fuera de producción, salvo SWAGGER_ENABLED=true
SWAGGER_ENABLED=false

# SafeScore Agent: ver backend/safescore-reviewer/.env.example
SAFESCORE_ENABLED=false
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
