# ═══════════════════════════════════════════════════════════
# SAFESCORE AGENT — Variables de entorno
# ═══════════════════════════════════════════════════════════
# Estas variables se suman al .env del backend SafeRide.
# Generá las 3 API keys en:
#   - Groq:     https://console.groq.com/keys
#   - Gemini:   https://aistudio.google.com/apikey
#   - Cerebras: https://cloud.cerebras.ai
# Ninguna pide tarjeta de crédito (verificado).
# ═══════════════════════════════════════════════════════════

# Flag maestro — pone false para deshabilitar el agente completamente
# (listeners no se registran, cron jobs no corren, emits son no-op)
SAFESCORE_ENABLED=true

# API Keys (free tier, sin tarjeta)
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CEREBRAS_API_KEY=csk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Configuración del agente
SAFESCORE_BLIND_WINDOW_HOURS=24      # tiempo de espera para doble ciego
SAFESCORE_WORKER_POLL_MS=2000        # cada cuánto el worker busca jobs (ms)
SAFESCORE_MAX_ATTEMPTS=3             # reintentos por job fallido
SAFESCORE_QUOTA_GUARD_PCT=80         # % de cuota libre antes de cambiar al fallback
