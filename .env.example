# Copiar como .env y completar.

# URL del backend. Si se deja vacía, en desarrollo la app usa automáticamente la
# IP de la PC que sirve Expo (puerto 8080). En web usa localhost.
EXPO_PUBLIC_API_URL=

# Claves del SDK nativo del mapa (rutas, direcciones y geocodificación van
# por el backend). Android: Maps SDK for Android, restringida a cr.saferide.app.
# iOS: Maps SDK for iOS, restringida al bundle cr.saferide.app.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# Respaldo común para desarrollo si no se definen las dos anteriores.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ID del proyecto EAS (lo da `eas init`). Necesario para las push del sistema.
EXPO_PUBLIC_EAS_PROJECT_ID=
