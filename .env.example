# Servidor
NODE_ENV=development
PORT=8080
API_VERSION=v1

# Cosmos DB for MongoDB (vCore)
COSMOS_CONNECTION_STRING=mongodb://your-cosmos-account:key@your-cosmos-account.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false
COSMOS_DATABASE=Safe-RideDB

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this
REFRESH_TOKEN_EXPIRE=7d

# Azure Blob Storage
BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT=your-storage-account-name

# Azure Key Vault (opcional)
KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Azure AD / Entra ID (opcional)
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_TENANT_ID=your-tenant-id

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# PayPal (sandbox: https://api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Colones por dólar para convertir el cobro (PayPal no opera en CRC). Por confirmar.
PAYPAL_CRC_PER_USD=510

# Clave de Google Maps del servidor: Directions, Places y Geocoding API, restringida por IP
GOOGLE_MAPS_SERVER_KEY=

# Swagger (/api-docs) solo fuera de produccion, salvo SWAGGER_ENABLED=true
SWAGGER_ENABLED=false
